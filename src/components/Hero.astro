---
<section id="hero" class="hero">
	<div class="hero-inner">
		<div class="hero-text-block">
			<div class="badge animate-fade-in">devxsota.cloud</div>
			<h1 class="animate-fade-in delay-1">Hola, soy Daniel desarrollador <span class="highlight">Java Backend</span></h1>
			<p class="animate-fade-in delay-2">
				Me especializo en el diseño y despliegue de arquitecturas distribuidas, 
				<strong>Microservicios</strong> robustos y APIs de alto rendimiento. Enfocado en escribir 
				código limpio, escalable y preparado para entornos Cloud Native.
			</p>
			<div class="actions animate-fade-in delay-3">
				<a href="#projects" class="btn primary">Ver Portafolio</a>
				<a href="#contact" class="btn secondary">Contactar</a>
			</div>
		</div>

		<div class="hero-image-block animate-fade-in delay-2">
			<img src="/hero-illustration.svg" alt="Ilustración Backend devxsota" class="hero-svg" />
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh; /* Cambiado a min-height para permitir que el contenido estire la sección si falta espacio */
		width: 100vw;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg-main);
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		padding: 80px 0; /* Añade espacio arriba y abajo para que el contenido no pegue a los bordes de la pantalla */
	}
	
	.hero-inner {
		max-width: 900px;
		width: 100%;
		padding: 0 20px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 40px;
		margin: 0 auto;
	}

	.hero-text-block {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
	}

	.hero-image-block {
		flex: 1;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100%; /* Asegura que no se desborde del contenedor */
	}

	.hero-svg {
		width: 100%;
		max-width: 380px;
		height: auto;
		filter: drop-shadow(0 0 20px rgba(0, 180, 216, 0.15)); 
	}

	.badge {
		background: rgba(0, 180, 216, 0.1);
		color: var(--accent);
		border: 1px solid var(--accent);
		padding: 6px 14px;
		border-radius: 20px;
		font-size: 0.9rem;
		font-weight: 600;
	}
	h1 {
		font-size: 3rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -1.5px;
	}
	.highlight {
		color: var(--accent);
	}
	p {
		font-size: 1.15rem;
		color: var(--text-secondary);
		max-width: 550px;
		line-height: 1.7;
	}
	.actions {
		display: flex;
		gap: 15px;
		margin-top: 10px;
	}
	.btn {
		padding: 12px 26px;
		border-radius: 6px;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
		font-size: 0.95rem;
	}
	.btn.primary {
		background: var(--accent);
		color: #0d1b2a;
	}
	.btn.primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(0, 180, 216, 0.3);
	}
	.btn.secondary {
		border: 1px solid var(--text-muted);
		color: var(--text-primary);
	}
	.btn.secondary:hover {
		border-color: var(--accent);
		color: var(--accent);
		background: rgba(0, 180, 216, 0.05);
	}

	/* ==========================================
	   ✨ SISTEMA DE ANIMACIÓN EN CASCADA
	   ========================================== */
	.animate-fade-in {
		opacity: 0;
		will-change: transform, opacity;
		animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	.delay-1 { animation-delay: 150ms; }
	.delay-2 { animation-delay: 300ms; }
	.delay-3 { animation-delay: 450ms; }

	@keyframes fadeInUp {
		0% {
			opacity: 0;
			transform: translateY(20px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* ==========================================
	   📱 RESPONSIVE DESIGN (TABLETS / MÓVILES)
	   ========================================== */
	@media (max-width: 768px) {
		.hero {
			padding: 60px 0; /* Ajusta el relleno superior en móviles */
		}
		.hero-inner {
			flex-direction: column-reverse; /* 🔄 Invertido: coloca la imagen ARRIBA del texto para mejor UX móvil */
			text-align: left;
			justify-content: center;
			gap: 30px;
		}
		.hero-text-block {
			align-items: flex-start;
			width: 100%;
		}
		h1 {
			font-size: 2.2rem; /* Tamaño de fuente más cómodo para pantallas chicas */
		}
		p {
			font-size: 1.05rem;
		}
		.actions {
			width: 100%;
			flex-direction: column; /* Botones apilados uno sobre otro en móviles */
			gap: 12px;
		}
		.btn {
			text-align: center;
			width: 100%; /* Botones de ancho completo para facilitar el clic táctil */
		}
		.hero-image-block {
			max-width: 220px; /* 🎯 Reducción estricta del bloque contenedor en móviles */
			margin: 0 auto;  /* Centra la imagen horizontalmente */
		}
		.hero-svg {
			max-width: 100%; /* Forzado a respetar el tamaño de su padre */
		}
	}
</style>